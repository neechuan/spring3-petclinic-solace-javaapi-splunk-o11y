# Copy this file to .env and fill in your Splunk Observability Cloud values.
# .env is gitignored so your access token stays out of version control.
#
# SPLUNK_REALM: your o11y cloud realm (e.g. us0, us1, eu0). Leave empty to
# export OTLP to a local Collector instead of sending straight to o11y cloud.
SPLUNK_REALM=us1
# SPLUNK_ACCESS_TOKEN: org access token used to authenticate direct ingest.
SPLUNK_ACCESS_TOKEN=

# --- Solace distributed tracing (broker monitoring via the OTel collector) ---
# The collector's `solace` receiver authenticates to the broker as this client
# username (SASL PLAIN over plaintext AMQP) and consumes broker spans from the
# #telemetry-<profile> queue. configure-solace-tracing.sh creates them on the
# broker; run-collector.sh forwards them into the collector.
SOLACE_TELEMETRY_USERNAME=otel-collector
SOLACE_TELEMETRY_PASSWORD=otel-collector
SOLACE_TELEMETRY_PROFILE=trace
# PetClinic RPC is pure *direct* messaging, which the broker won't trace on its
# own (only guaranteed / "promoted direct"). configure-solace-tracing.sh creates a
# small TTL-bounded queue subscribed to petclinic/rpc/> to promote (spool) those
# direct requests so the broker emits spans. These tune that queue:
SOLACE_TRACE_PROMOTE_QUEUE=q-petclinic-trace
SOLACE_TRACE_PROMOTE_TTL=10          # seconds; spooled copies auto-expire
SOLACE_TRACE_PROMOTE_SPOOL_MB=50     # hard spool-usage cap (MB)
# Shared podman network the broker and collector both attach to.
PETCLINIC_NET=petclinic-net
